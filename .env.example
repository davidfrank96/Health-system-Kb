# pnpm local sets these in memory. For a manually managed native cluster, export
# explicit values privately. Never use cloud hosts, production DBs or real test users.
KBEAN_DB_TIER=development
KBEAN_DB_NAME=kbean_development
KBEAN_DB_USER=kbean_development_web
KBEAN_DB_HOST=127.0.0.1
KBEAN_DB_PORT=5432
KBEAN_DB_PASSWORD=
# Only migration/owner processes receive KBEAN_MIGRATION_USER and KBEAN_MIGRATION_PASSWORD.
# OIDC settings are generated by the local synthetic issuer launcher.
APP_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
