{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"esModuleInterop": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "test-results", "playwright-report", "**/.next"]
}
